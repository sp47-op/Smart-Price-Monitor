# Price monitoring mode (public demo product page)
PRODUCT_URL=https://www.demoblaze.com/prod.html?idp_=1
TITLE_SELECTOR=h2.name
PRICE_SELECTOR=.price-container
TIMEOUT_MS=15000
LOG_LEVEL=INFO
HEADLESS=true

# Optional email notification (leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
SMTP_USE_TLS=true

# Optional threshold; informational only, no purchase is made
TARGET_PRICE=
